# Builder image used by every CodeBuild job that runs podman.
# Built and pushed to ECR automatically by the pipeline's "Builder" stage,
# and only rebuilt when this file changes (content hash check).
#
# quay.io/podman/stable is already tuned for nested podman: it declares
# VOLUME /var/lib/containers (so overlay storage sits on a real filesystem,
# not on the CodeBuild container's overlayfs) and uses cgroupfs.
FROM quay.io/podman/stable:latest

RUN dnf -y install skopeo jq awscli2 git && dnf clean all

ARG COSIGN_VERSION=v2.4.1
RUN arch="$(uname -m | sed 's/x86_64/amd64/;s/aarch64/arm64/')" && \
    curl -sSfL -o /usr/local/bin/cosign \
      "https://github.com/sigstore/cosign/releases/download/${COSIGN_VERSION}/cosign-linux-${arch}" && \
    chmod +x /usr/local/bin/cosign && cosign version

# One auth file shared by podman, skopeo and cosign.
ENV REGISTRY_AUTH_FILE=/root/.docker/config.json \
    BUILDAH_ISOLATION=chroot
RUN mkdir -p /root/.docker
