# Minimal bootc image to put in the source repo and prove the pipeline end to end.
# For RHEL: FROM registry.redhat.io/rhel10/rhel-bootc:10.0 (and set redhat_registry_secret_arn).
FROM quay.io/centos-bootc/centos-bootc:stream10

# cloud-init lets AMIs built from this image pick up EC2 key pairs and user data.
RUN dnf -y install tmux cloud-init && dnf clean all

# Fail fast here too (the pipeline also lints every build).
RUN bootc container lint
